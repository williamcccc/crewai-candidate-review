# 複製為 .env 後填入。.env 已列入 .gitignore，不會進版控。

# ===== Gemini =====
# 注意：Gemini API 免費方案的資料可能被用於改進 Google 產品；要送真實履歷請使用付費方案的金鑰。
GEMINI_API_KEY=
GEMINI_MODEL=gemini/gemini-3.8-flash

# ===== 隱私 =====
# 以下開關由 review_crew/privacy.py 在程式中「強制」設定，即使在這裡改成其他值也不會生效，
# 列出來只是讓你知道有這些設定：
#   CREWAI_TRACING_ENABLED=false     關閉執行軌跡上傳（CrewAI 預設首次執行會自動上傳，內容含 LLM 輸入輸出）
#   CREWAI_DISABLE_TELEMETRY=true    關閉匿名遙測
#   CREWAI_DISABLE_TRACKING=true
#   OTEL_SDK_DISABLED=true
#   CREWAI_DISABLE_VERSION_CHECK=true
